# ── Kick OAuth (required for production) ──────────────────────
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_REDIRECT_URI=

# ── Public URL (used by watchdogs for webhook callback) ───────
PUBLIC_BASE_URL=

# ── Admin / Security ─────────────────────────────────────────
ADMIN_KEY=my-secret-admin-key
# SESSION_SECRET=          # auto-generated if not set
# ENCRYPTION_KEY=          # auto-generated if not set

# ── Beta Gate ────────────────────────────────────────────────
REQUIRE_INVITE=true        # set to "false" to disable invite requirement

# ── Database ─────────────────────────────────────────────────
# DB_PATH=./data/wheeloffortune.db   # default

# ── Dev / Local Testing ─────────────────────────────────────
DEV_BYPASS_AUTH=1          # skip Kick OAuth, use fake sessions
DEV_FAKE_BID=999999        # default broadcaster ID for dev login
# DEV_BYPASS_KEY=          # optional key for /auth/dev-login

# ── Server ───────────────────────────────────────────────────
PORT=3000
# NODE_ENV=development
